# Terra partner demo — environment template. Copy to .env and fill in.
# NEVER commit .env; credentials live only on the demo host. Generate every
# secret on the server: openssl rand -hex 24 (db) / -hex 32 (invite secret).
DEMO_DB_PASSWORD=change-me-long-random
# Runtime application database role (no superuser, no BYPASSRLS; RLS applies).
DB_APP_ROLE=terra_app
DB_APP_PASSWORD=change-me-long-random-too
# Pin the pack checksum at release (sha256sum demo/pack/northwind_freight.v1.json):
# current release pin: 2cb625e0b3005004ec7fcc6ba6710df7258dbfb2d722b18cd4038d0036a8f259
DEMO_PACK_SHA256=
# Unset DEMO_INVITE_SECRET disables in-app enrollment entirely (accounts then
# come only from provision_presenter.py).
DEMO_INVITE_SECRET=
DEMO_ALLOWED_ORIGIN=^https://demo\.tempris-singapore\.com$
