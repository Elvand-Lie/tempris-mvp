# Tempris V2 Environment Example
DATABASE_URL=postgresql://tempris_v2_app:<password>@127.0.0.1:55432/tempris_v2_test
JWT_SECRET=<jwt_secret>
JWT_ALGORITHM=HS256
PORT=8000
COLLECTOR_SERVER_URL=http://127.0.0.1:8000

# Admin Provisioning (Required)
# Generate ADMIN_PASSWORD_HASH securely using:
# python -c "from app.auth_crypto import generate_scrypt_hash; import getpass; print(generate_scrypt_hash(getpass.getpass('Admin Password: ')))"
#
# ADMIN_TENANT_ID is pinned to the dedicated platform login-context tenant
# (Tempris Platform Control). The operational Tempris tenant
# (11111111-1111-1111-1111-111111111111) owns Assets/Collectors and must NOT
# be used here. ADMIN_USERNAME shows the deployed platform identity.
ADMIN_USERNAME=admin@tempris.com
ADMIN_TENANT_ID=f0000000-0000-4000-8000-000000000001
ADMIN_PASSWORD_HASH=<scrypt_password_hash>
