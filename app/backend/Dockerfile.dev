# Tempris Backend — Lightweight Dev Dockerfile
# Skips nmap/nuclei (Scanner module will gracefully degrade)
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Ensure data directories exist
RUN mkdir -p /app/data/evidence /app/data/chroma

EXPOSE 8000

# Dev mode: hot reload enabled, binds to 0.0.0.0
CMD ["uvicorn", "index:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
