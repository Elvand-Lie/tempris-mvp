# Tempris Backend Secrets — Copy to .env and fill in values
# ─────────────────────────────────────────────────────────

# Database connection string
# REQUIRED for production (PostgreSQL)
# LOCAL DEV: Leave unset → backend auto-falls back to SQLite (tempris.db)
DATABASE_URL=postgresql://tempris:YOUR_DB_PASSWORD@localhost:5432/tempris_db

# JWT signing secret — used for auth tokens
# REQUIRED for production (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# LOCAL DEV: Leave unset → backend uses a dev-only fallback (prints a warning)
JWT_SECRET_KEY=YOUR_JWT_SECRET

# Tamper-evident audit-chain signing. Rotate by assigning a new short key ID
# and key, while retaining prior verification-only keys in the JSON mapping.
AUDIT_HMAC_KEY=YOUR_AUDIT_HMAC_KEY
AUDIT_HMAC_KEY_ID=primary
AUDIT_HMAC_PREVIOUS_KEYS={}

# Shared engagement token for authenticated third-party AEV verdict intake.
# Generate a high-entropy value and distribute it only to the approved connector.
AEV_VERDICT_ENGAGEMENT_TOKEN=YOUR_AEV_VERDICT_ENGAGEMENT_TOKEN

# FreeLLMAPI key — must match ENCRYPTION_KEY in freellmapi/.env
# OPTIONAL: If unset, SPEAK/SPOTLIGHT modules return intelligent mock responses
FREELLM_API_KEY=YOUR_FREELLM_API_KEY

# FreeLLMAPI base URL — where the LLM proxy service runs
# Default: http://localhost:3001/v1 (no change needed for local dev)
FREELLM_BASE_URL=http://localhost:3001/v1

# Allowed CORS origins (comma-separated)
# LOCAL DEV: http://localhost:5173,http://localhost:8000
# PRODUCTION: Add your actual domain(s)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Enable HSTS header (Strict-Transport-Security)
# LOCAL DEV: Set to false (no SSL locally)
# PRODUCTION: Set to true
ENABLE_HSTS=false
